# Environment variable names only — never commit real secrets

# Database (Cloud SQL Postgres in production)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/vigil

# Cookie sessions (≥32 random bytes)
SESSION_SECRET=

# Optional Clerk (if set, Clerk middleware takes priority)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# News
TINYFISH_API_KEY=
TAVILY_API_KEY=

# LLM (at least one path required — multi-failover)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_ANTHROPIC_BASE=https://agentrouter.org
VENICE_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
VIGIL_LLM_MODEL=gpt-4o-mini
VIGIL_LLM_ORDER=relay,agentrouter,agentrouter-anthropic,venice,dashscope
# Optional clean-egress relay (CF Worker: worker/llm-relay.ts)
VIGIL_LLM_RELAY_URL=
VIGIL_LLM_RELAY_KEY=

# Bitget Agent Hub paper (Demo API key)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_PAPER=true
BITGET_BASE_URL=https://api.bitget.com

# Worker
VIGIL_WORKER_INTERVAL_MS=60000
VIGIL_DEFAULT_TENANT_SLUG=vigil-demo
