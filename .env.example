# Environment variable names only — never commit real secrets

# Database (Cloud SQL Postgres in production)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/vigil

# Cookie sessions (≥32 random bytes)
SESSION_SECRET=

# Optional Clerk (publishable key only — never put CLERK_SECRET_KEY in VITE_*)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Public site URL (SEO / OG). Not a secret.
VITE_SITE_URL=https://vigil-one-wine.vercel.app
SITE_URL=https://vigil-one-wine.vercel.app

# Optional privacy-friendly analytics domain (loaded only after cookie Accept)
# VITE_PLAUSIBLE_DOMAIN=vigil-one-wine.vercel.app

# News
TINYFISH_API_KEY=
TAVILY_API_KEY=

# LLM (at least one path required — multi-failover)
AGENTROUTER_API_KEY=
# OpenAI base includes /v1; Anthropic base does NOT
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_ANTHROPIC_BASE=https://agentrouter.org
# Tor SOCKS clears Aliyun captcha from cloud VMs (bun run tor:start)
AGENTROUTER_USE_TOR=1
AGENTROUTER_TOR_SOCKS=socks5h://127.0.0.1:9050
# Local sync-Anthropic fingerprint proxy (scripts/agentrouter-proxy/start.sh → :7187)
AGENTROUTER_PROXY_URL=
VENICE_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
VIGIL_LLM_MODEL=deepseek-v4-flash
VIGIL_LLM_ORDER=relay,agentrouter-proxy,agentrouter,agentrouter-anthropic,venice,dashscope
# Optional clean-egress relay (CF Worker: worker/llm-relay.ts)
VIGIL_LLM_RELAY_URL=
VIGIL_LLM_RELAY_KEY=

# Bitget Agent Hub paper (Demo API key)
# Prefer per-tenant keys in Settings (encrypted). Env is ops-only fallback when:
# VIGIL_ALLOW_ENV_BITGET=1
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_PAPER=true
BITGET_BASE_URL=https://api.bitget.com
# VIGIL_ALLOW_ENV_BITGET=0

# Worker
VIGIL_WORKER_INTERVAL_MS=60000
VIGIL_DEFAULT_TENANT_SLUG=vigil-demo
